# ===== AI 旅行搭子 后端配置 =====
# 复制本文件为 .env 后填写。.env 已被 gitignore。
# 变量名与 my-website 保持一致（DATABASE_URL / DEEPSEEK_API_KEY），未来并库可直接复用。

# ---------- 数据库（MySQL） ----------
# 格式：mysql+pymysql://用户:密码@主机:端口/库名?charset=utf8mb4
# 库不存在时会自动 CREATE DATABASE（需要账号有建库权限）
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/triptide?charset=utf8mb4
DB_ECHO=false

# 留空 DATABASE_URL 时自动退化为 SQLite（backend/data/triptide.db），零配置也能跑

# ---------- 模型服务 ----------
# MODEL_API_KEY 与 DEEPSEEK_API_KEY 等价，写哪个都认
DEEPSEEK_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-flash

# 生成质量与耗时
LLM_TIMEOUT=180
LLM_MAX_RETRY=1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# 私有化 / 代理部署（可选，走 deployment="private" 时生效）
PRIVATE_LLM_API_KEY=
PRIVATE_LLM_BASE_URL=
PRIVATE_LLM_MODEL=

# ---------- 高德开放平台（Web 服务 Key，用于 POI 搜索补 GCJ-02 坐标） ----------
# 控制台申请「Web服务」类型 Key，不是 JS API 的 Key
AMAP_KEY=
AMAP_BASE_URL=https://restapi.amap.com

# ---------- 其它 ----------
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
